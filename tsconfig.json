{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./upstream/bulwark/*"
      ],
      "@/i18n/navigation": [
        "./src/desktop/navigation.tsx"
      ],
      "@/lib/plugin-storage": [
        "./src/desktop/plugin-storage.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}
