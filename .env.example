# Local development and integration-test credentials only.
# Read only by native/test tooling; never expose through frontend build variables.
JMAP_SESSION_URL=https://mail.example.com/.well-known/jmap
JMAP_USERNAME=
JMAP_PASSWORD=
# Missing setting defaults to true. Keep true for a production account.
JMAP_READ_ONLY=true

# The ignored one-blob live test reads this gate from the process environment,
# not this file. Requires explicit authorization for exactly 1024 synthetic bytes.
# JMAP_UPLOAD_TEST=one-blob-1024
# It never creates Email/FileNode objects or sends mail. An existing receipt at
# .cache/live-upload-roundtrip.json blocks another upload, including after failure.
# The separately identified HTTP-200 correction run preserves that receipt:
# JMAP_UPLOAD_RUN=http200-fix
# For profile-based logins, point JMAP_TEST_REGISTRY at the app's jmap.redb.
# Only a locked temporary copy is opened/recovered; source bytes stay unchanged.
